[Unit]
Description=SSH SOCKS tunnel to relay (Telegram API)
After=network-online.target
Wants=network-online.target

[Service]
User=diary
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N -D 127.0.0.1:1080 -i /home/diary/.ssh/tunnel_key -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new tunnel@RELAY_IP
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
