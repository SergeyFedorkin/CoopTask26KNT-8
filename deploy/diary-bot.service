[Unit]
Description=Diary Telegram bot
After=network-online.target tg-tunnel.service
Wants=network-online.target tg-tunnel.service

[Service]
User=diary
WorkingDirectory=/opt/diary_bot
ExecStart=/opt/diary_bot/venv/bin/python bot.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
