# Токен от @BotFather
BOT_TOKEN=123456789:AAAA...

# Только эти Telegram ID могут пользоваться ботом (через запятую). Пусто — все.
# Свой ID можно узнать у @userinfobot
ALLOWED_USERS=

TZ_NAME=Europe/Moscow

# Прокси для Telegram, если api.telegram.org тормозит (нужен пакет aiohttp-socks)
# TG_PROXY=socks5://127.0.0.1:1080

# Прокси для RUZ, если бот крутится на зарубежном сервере, а ruz.hse.ru режет не-российские IP
# RUZ_PROXY=http://user:pass@ru-proxy:3128
# RUZ_VERIFY_SSL=1
