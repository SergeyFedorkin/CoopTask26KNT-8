# Токен от @BotFather
BOT_TOKEN=123456789:AAAA...

# Только эти Telegram ID могут пользоваться ботом (через запятую). Пусто — все.
# Свой ID можно узнать у @userinfobot
ALLOWED_USERS=

TZ_NAME=Europe/Moscow

# Google-таблица с расписанием 
# По умолчанию — 1 модуль ИМиКН. Для нового модуля вставь новую ссылку.
# SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit

# Прокси для Telegram
# TG_PROXY=socks5://127.0.0.1:1080

# Прокси для RUZ
